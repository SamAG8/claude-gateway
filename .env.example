# --- Runtime config (read via python-dotenv) ---
# API_KEY is the shared static door lock (x-api-key). With per-user PAT auth
# enabled (below), it becomes an OPTIONAL fallback for callers that don't send a
# user token — you can leave it unset in a PAT-only deployment.
API_KEY=change-me
# Optional: additional accepted keys, comma-separated (merged with API_KEY).
# API_KEYS=key1,key2

# --- Per-user PAT auth (login is the single credential) ---
# When TOKEN_INTROSPECT_URL is set, a request may authenticate with the user's own
# ConstraAP PAT (cap_…) as x-api-key instead of the shared API_KEY: the gateway
# POSTs the token here and accepts it iff the response is {"active": true}. The
# validated PAT is then reused as the per-user MCP token, so company data is scoped
# to that user automatically. Fail-closed: if this endpoint is unreachable, the
# token is rejected. Point it at ConstraAP's introspection route.
# TOKEN_INTROSPECT_URL=https://ap.constralabs.ai/api/mcp-tokens/introspect
# INTROSPECT_SECRET=   # sent as x-introspect-secret; must match ConstraAP's MCP_INTROSPECT_SECRET
# INTROSPECT_CACHE_TTL=60   # seconds to cache a validation result (revoke lag)
# INTROSPECT_TIMEOUT=8      # per-call HTTP timeout, seconds
HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT=5
TIMEOUT=120
MAX_FILE_SIZE=10485760
# Max bytes per stream-json line read from the CLI (asyncio StreamReader limit).
# The default 64 KiB is too small for lines that echo base64 media; the engine also
# auto-scales this up to 2x the per-request stdin payload. Only raise if you see a
# 502 "stream line exceeded gateway limit".
STREAM_LIMIT=33554432

# Contamination isolation: "clean" (default; system-prompt override + no settings,
# keeps the machine's Claude subscription/OAuth) or "bare" (--bare; requires ANTHROPIC_API_KEY).
ISOLATION_MODE=clean
# ANTHROPIC_API_KEY=   # required only when ISOLATION_MODE=bare

# Editable model map (hot-reloaded by mtime). DEFAULT_MODEL overrides its "default" when set.
MODELS_FILE=models.json
# DEFAULT_MODEL=sonnet

# Reasoning effort for `claude --effort` (low|medium|high|xhigh|max). Empty = CLI default.
# Set high/xhigh to give Opus 4.8 a larger thinking budget (e.g. ConstraBid extraction).
# EFFORT=high

# --- MCP connector (per-user company data) ---
# Set MCP_SERVER_URL to a remote (HTTP) MCP server (e.g. ConstraAP's /mcp). When
# set, requests carrying an `x-mcp-token` header run the `claude` CLI with that
# server attached, scoped to its tools only (built-in tools stay disabled). The
# token is per-user and comes from the caller (e.g. Nimbus sends the user's PAT).
# Leave blank to disable MCP entirely (plain chat only).
# MCP_SERVER_URL=https://ap.constralabs.ai/mcp
# MCP_SERVER_NAME=constraap

# --- Deployment config (used to template claude-gateway.service) ---
# systemd cannot expand ${VAR} in User=/Group=/WorkingDirectory=/EnvironmentFile=,
# so these must match the values hard-coded in claude-gateway.service.
# HOST and PORT above ARE read by the unit's ExecStart at runtime.
SERVICE_USER=gateway
SERVICE_GROUP=gateway
INSTALL_DIR=/home/gateway/claude-gateway
